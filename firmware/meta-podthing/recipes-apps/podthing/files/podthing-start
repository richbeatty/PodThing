#!/bin/sh
set -eu
# The app is the boot experience. No Prelude process or configuration is used.
# USB host activation is an on-screen action so an unqualified PD hub never
# causes an automatic boot-time role change. Device mode keeps recovery access.
exec /usr/bin/podthing --state-dir /var/lib/podthing --listen 0.0.0.0:8787
