#!/bin/sh
# PodThing's transient USB role switch. The service boots in host mode;
# selecting computer recovery temporarily changes to USB device mode.
set -eu
role_path=
for path in /sys/class/usb_role/*/role; do
    [ -e "$path" ] && { role_path=$path; break; }
done
[ -n "$role_path" ] || { echo 'USB role switch is unavailable' >&2; exit 1; }
gadget=/sys/kernel/config/usb_gadget/podthing
stop_network() {
    if [ -f /run/podthing-dhcp.pid ]; then
        kill "$(cat /run/podthing-dhcp.pid)" 2>/dev/null || true
        rm -f /run/podthing-dhcp.pid
    fi
    ip link set podusb0 down 2>/dev/null || true
}
case "${1:-status}" in
    to-host)
        [ "${2:---no-revert}" = --no-revert ] || exit 2
        stop_network
        if [ -f "$gadget/UDC" ]; then printf '\n' > "$gadget/UDC"; fi
        printf host > "$role_path"
        echo 'USB host enabled. Connect a powered OTG hub and iPod.'
        ;;
    to-device)
        stop_network
        printf device > "$role_path"
        mountpoint -q /sys/kernel/config || mount -t configfs configfs /sys/kernel/config
        mkdir -p "$gadget"
        if [ ! -d "$gadget/configs/c.1" ]; then
            printf 0x1d6b > "$gadget/idVendor"
            printf 0x0104 > "$gadget/idProduct"
            mkdir -p "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409" "$gadget/functions/ncm.usb0"
            # Network MACs identify only the local USB link, never the iPod.
            serial=$(cat /etc/machine-id)
            printf '%s' "$serial" > "$gadget/strings/0x409/serialnumber"
            printf PodThing > "$gadget/strings/0x409/manufacturer"
            printf 'PodThing recovery' > "$gadget/strings/0x409/product"
            printf '02:50:54:00:00:01' > "$gadget/functions/ncm.usb0/dev_addr"
            printf '02:50:54:00:00:02' > "$gadget/functions/ncm.usb0/host_addr"
            printf 'podusb%%d' > "$gadget/functions/ncm.usb0/ifname"
            printf 'PodThing recovery network' > "$gadget/configs/c.1/strings/0x409/configuration"
            printf 250 > "$gadget/configs/c.1/MaxPower"
            ln -s "$gadget/functions/ncm.usb0" "$gadget/configs/c.1/ncm.usb0"
        fi
        if [ -z "$(cat "$gadget/UDC")" ]; then
            udc=
            attempt=0
            while [ -z "$udc" ] && [ "$attempt" -lt 12 ]; do
                for path in /sys/class/udc/*; do [ -e "$path" ] && { udc=${path##*/}; break; }; done
                [ -n "$udc" ] && break
                attempt=$((attempt + 1))
                sleep 0.25
            done
            [ -n "$udc" ] || { echo 'USB device controller is unavailable' >&2; exit 1; }
            printf '%s' "$udc" > "$gadget/UDC"
        fi
        attempt=0
        while [ ! -d /sys/class/net/podusb0 ] && [ "$attempt" -lt 12 ]; do
            attempt=$((attempt + 1))
            sleep 0.25
        done
        ip addr replace 10.42.1.2/29 dev podusb0
        ip link set podusb0 up
        /usr/sbin/dnsmasq --conf-file=/dev/null --port=0 --interface=podusb0 \
            --bind-interfaces --dhcp-range=10.42.1.3,10.42.1.6,255.255.255.248,1h \
            --dhcp-option=3 --dhcp-option=6 --dhcp-leasefile=/run/podthing-dhcp.leases \
            --pid-file=/run/podthing-dhcp.pid --user=root
        echo 'USB recovery: http://10.42.1.2:8787'
        ;;
    status) cat "$role_path" ;;
    *) echo 'Usage: superbird-usb-role to-host --no-revert | to-device | status' >&2; exit 2 ;;
esac
